<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Comfortaa:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>

  {% if template.name == 'index' %}
    {% assign home_anchor = '' %}
  {% else %}
    {% assign home_anchor = routes.root_url %}
  {% endif %}
  {% if template.name == 'index' or template.name == 'product' %}
    {% assign comprar_href = '#comprar' %}
  {% else %}
    {% assign comprar_href = routes.root_url | append: '#comprar' %}
  {% endif %}

  <header class="ben-header" data-animate>
    <a href="{{ routes.root_url }}" class="ben-logo">BENTA</a>
    <nav class="ben-nav">
      <a href="{{ home_anchor }}#produto">Produto</a>
      <a href="{{ home_anchor }}#receitas">Receitas</a>
      <a href="{{ home_anchor }}#historia">A história</a>
    </nav>
    <div class="ben-header-actions">
      <a href="{{ comprar_href }}" class="ben-btn ben-btn-sm">Comprar</a>
      <a href="{{ routes.cart_url }}" class="ben-cart" aria-label="Carrinho, {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}itens{% endif %}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span class="ben-cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </header>

  <main>
    {{ content_for_layout }}
  </main>

  <footer class="ben-footer">
    <div class="ben-footer-top">
      <span class="ben-footer-logo">BENTA</span>
      <p>Licor fino de coco. Sem lactose. Bem gelado.</p>
    </div>
    <div class="ben-footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>Consuma com moderação. Venda proibida para menores de 18 anos.</span>
    </div>
  </footer>

  <div class="ben-toast" id="ben-toast" role="status" aria-live="polite"></div>

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
