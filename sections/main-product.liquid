<section class="ben-buy" id="comprar" style="min-height:80vh">
  <div class="ben-buy-media" data-animate>
    <div class="ben-bottle-fx" data-parallax>
      <div class="ben-bottle-float">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" data-bottle-tilt>
        {% else %}
          <img src="{{ 'benta-bottle.jpg' | asset_url }}" alt="{{ product.title | escape }}" data-bottle-tilt>
        {% endif %}
        <div class="ben-bottle-shine" aria-hidden="true"></div>
      </div>
    </div>
  </div>
  <div class="ben-buy-info" data-animate data-animate-delay="1">
    <p class="ben-eyebrow">LICOR FINO DE COCO</p>
    <h1 class="ben-dl">{{ product.title }}</h1>
    <div class="ben-buy-desc">{{ product.description }}</div>
    <p class="ben-price">{{ product.selected_or_first_available_variant.price | money }}</p>
    {% form 'product', product %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <p class="ben-lbl" style="margin-top:1rem">{{ option.name }}</p>
          <select name="options[{{ option.name | escape }}]" class="ben-qty-input" style="width:auto;padding:.6rem 1rem;border:1.5px solid var(--linha);border-radius:100px">
            {% for value in option.values %}
              <option value="{{ value | escape }}">{{ value }}</option>
            {% endfor %}
          </select>
        {% endfor %}
      {% endunless %}
      <div class="ben-qty">
        <button type="button" class="ben-qty-btn" data-qty-minus>-</button>
        <input type="number" name="quantity" value="1" min="1" class="ben-qty-input">
        <button type="button" class="ben-qty-btn" data-qty-plus>+</button>
      </div>
      <button type="submit" class="ben-btn ben-btn-full" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        {% if product.selected_or_first_available_variant.available %}Adicionar ao carrinho{% else %}Esgotado{% endif %}
      </button>
    {% endform %}
  </div>
</section>

{% schema %}
{ "name": "Produto principal" }
{% endschema %}
