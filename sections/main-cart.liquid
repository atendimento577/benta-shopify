<section style="padding:4rem clamp(1.2rem,5vw,4rem);min-height:60vh">
  <h1 class="ben-dl" style="margin-bottom:2rem">Seu carrinho</h1>
  {% if cart.item_count == 0 %}
    <p>Seu carrinho está vazio.</p>
    <a href="{{ routes.root_url }}" class="ben-btn" style="margin-top:1.4rem">Voltar pra loja</a>
  {% else %}
    {% form 'cart', cart %}
      {% for item in cart.items %}
        <div style="display:flex;gap:1.2rem;align-items:center;padding:1rem 0;border-bottom:1px solid var(--linha)">
          <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" style="width:80px;height:80px;object-fit:cover;border-radius:12px">
          <div style="flex:1">
            <p style="font-weight:600">{{ item.product.title }}</p>
            <p class="ben-lbl">{{ item.variant.title }}</p>
          </div>
          <input type="number" name="updates[{{ forloop.index0 }}]" value="{{ item.quantity }}" min="0" class="ben-qty-input">
          <p>{{ item.final_line_price | money }}</p>
        </div>
      {% endfor %}
      <p class="ben-price" style="margin-top:1.6rem">Total: {{ cart.total_price | money }}</p>
      <button type="submit" name="checkout" class="ben-btn ben-btn-full">Finalizar compra</button>
    {% endform %}
  {% endif %}
</section>

{% schema %}
{ "name": "Carrinho" }
{% endschema %}
